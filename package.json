{
  "name": "my-next-filing",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt --write package.json index.html tsconfig.json vite.config.ts vitest.config.ts playwright.config.ts lighthouserc.cjs scripts src tests remotion.config.ts video",
    "format:check": "oxfmt --check package.json index.html tsconfig.json vite.config.ts vitest.config.ts playwright.config.ts lighthouserc.cjs scripts src tests remotion.config.ts video",
    "lint": "oxlint --deny-warnings --ignore-pattern 'public/video/hls/**/*.ts'",
    "lint:fix": "oxlint --fix --deny-warnings --ignore-pattern 'public/video/hls/**/*.ts'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rules:validate": "tsx scripts/validate-rules.ts",
    "verify:build": "node --experimental-strip-types scripts/verify-build.ts",
    "verify:release": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm rules:validate && pnpm test && pnpm build && pnpm verify:build && playwright test",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:performance": "pnpm build && node scripts/lighthouse.ts",
    "video:studio": "remotion studio video/src/index.ts --port=3001",
    "video:record": "tsx video/record-browser.ts",
    "video:render": "remotion render video/src/index.ts Submission video/out/my-next-filing-demo-v3-sfx-1080p.mp4 --scale=0.75 --codec=h264 --crf=16 --audio-bitrate=192k --pixel-format=yuv420p --color-space=bt709 --image-format=png --concurrency=6",
    "video:render:audio": "remotion render video/src/index.ts Soundtrack video/out/my-next-filing-demo-v3-soundtrack.wav --codec=wav --concurrency=6",
    "video:mux:audio": "ffmpeg -v error -y -i video/out/my-next-filing-demo-v3-sfx-1080p.mp4 -i video/out/my-next-filing-demo-v3-soundtrack.wav -map 0:v:0 -map 1:a:0 -c:v copy -c:a aac -b:a 192k -ar 48000 -movflags +faststart video/out/my-next-filing-demo-v3-remixed-1080p.mp4",
    "video:test": "tsx --test video/recording.test.ts",
    "video:package": "tsx video/package-video.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mux/mux-player-react": "^3.13.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-confetti-boom": "^2.0.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "5.0.0",
    "vitest-browser-react": "2.3.0",
    "wrangler": "^4.127.0",
    "@remotion/cli": "4.0.521",
    "@remotion/transitions": "4.0.521",
    "remotion": "4.0.521",
    "zod": "4.5.4"
  },
  "packageManager": "pnpm@11.24.0"
}
