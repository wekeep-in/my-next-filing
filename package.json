{
  "name": "my-next-filing",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt --write package.json index.html tsconfig.json vite.config.ts scripts src",
    "format:check": "oxfmt --check package.json index.html tsconfig.json vite.config.ts scripts src",
    "lint": "oxlint --deny-warnings --ignore-pattern 'public/video/hls/**/*.ts'",
    "lint:fix": "oxlint --fix --deny-warnings --ignore-pattern 'public/video/hls/**/*.ts'",
    "test": "tsx scripts/verify.ts && tsx scripts/verify-frontend.ts && tsx scripts/verify-salary.ts && tsx scripts/verify-gst-calendar.ts",
    "typecheck": "tsc --noEmit",
    "rules:validate": "tsx scripts/validate-rules.ts",
    "verify:build": "node --experimental-strip-types scripts/verify-build.ts",
    "verify:release": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm rules:validate && pnpm test && pnpm build && pnpm verify:build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mux/mux-player-react": "^3.13.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-confetti-boom": "^2.0.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  },
  "packageManager": "pnpm@11.24.0"
}
