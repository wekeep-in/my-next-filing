{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-next-filing",
  "compatibility_date": "2026-08-29",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "mynextfiling.wekeep.in",
      "custom_domain": true
    }
  ]
}
